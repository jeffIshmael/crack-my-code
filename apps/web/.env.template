# Default environment variables for generated Celo projects
# Public Celo RPC (mainnet)
CELO_RPC_URL=https://forno.celo.org

# Database (Supabase: pooler for app, direct for migrations)
# App runtime uses DATABASE_URL via src/lib/prisma.ts
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Prisma CLI (migrate, studio) — session pooler :5432 (not db.* unless you have IPv4 add-on)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# RainbowKit Wallet Configuration
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Public URL for Farcaster share embeds (must match manifest domain)
NEXT_PUBLIC_APP_URL=https://crack-my-code.vercel.app

# Backend signer for resolveMatch / expireMatch — MUST be the contract backendAddress
# (or owner). Wrong key = cash winners never get paid (resolve fails silently).
AGENT_PRIVATE_KEY=0x_your_backend_private_key

# Farcaster manifest: sign accountAssociation at
# https://farcaster.xyz/~/developers/mini-apps/manifest
# then paste the block into public/.well-known/farcaster.json
